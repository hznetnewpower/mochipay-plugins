{{ header }}{{ column_left }}
<div id="content"><div class="page-header"><div class="container-fluid"><div class="pull-right"><button type="submit" form="form-mochipay" class="btn btn-primary"><i class="fa fa-save"></i></button><a href="{{ cancel }}" class="btn btn-default"><i class="fa fa-reply"></i></a></div><h1>{{ heading_title }}</h1></div></div>
<div class="container-fluid">{% if error_warning %}<div class="alert alert-danger">{{ error_warning }}</div>{% endif %}
<div class="panel panel-default"><div class="panel-heading"><h3 class="panel-title">{{ text_edit }}</h3></div><div class="panel-body"><p><strong>Callback URL:</strong> <code>{{ callback_url }}</code></p>
<form action="{{ action }}" method="post" id="form-mochipay" class="form-horizontal">
{% set text_fields = ['title','api_url','api_key','api_secret','sort_order'] %}{% for field in text_fields %}<div class="form-group"><label class="col-sm-2 control-label">{{ attribute(_context, 'entry_' ~ field) }}</label><div class="col-sm-10"><input type="{{ field == 'api_secret' ? 'password' : 'text' }}" name="payment_mochipay_{{ field }}" value="{{ attribute(_context, 'payment_mochipay_' ~ field) }}" class="form-control" />{% if field == 'payment_methods' %}<p class="help-block">{{ help_payment_methods }}</p>{% endif %}</div></div>{% endfor %}
<div class="form-group"><label class="col-sm-2 control-label">{{ entry_unique_direction }}</label><div class="col-sm-10"><select name="payment_mochipay_unique_direction" class="form-control"><option value="UP"{{ payment_mochipay_unique_direction == 'UP' ? ' selected' : '' }}>UP</option><option value="DOWN"{{ payment_mochipay_unique_direction == 'DOWN' ? ' selected' : '' }}>DOWN</option></select></div></div>
{% for type in ['pending','paid'] %}<div class="form-group"><label class="col-sm-2 control-label">{{ attribute(_context, 'entry_' ~ type ~ '_status') }}</label><div class="col-sm-10"><select name="payment_mochipay_{{ type }}_status_id" class="form-control">{% for status in order_statuses %}<option value="{{ status.order_status_id }}"{{ attribute(_context, 'payment_mochipay_' ~ type ~ '_status_id') == status.order_status_id ? ' selected' : '' }}>{{ status.name }}</option>{% endfor %}</select></div></div>{% endfor %}
<div class="form-group"><label class="col-sm-2 control-label">{{ entry_status }}</label><div class="col-sm-10"><select name="payment_mochipay_status" class="form-control"><option value="1"{{ payment_mochipay_status ? ' selected' : '' }}>{{ text_enabled }}</option><option value="0"{{ not payment_mochipay_status ? ' selected' : '' }}>{{ text_disabled }}</option></select></div></div>
<div class="form-group"><label class="col-sm-2 control-label">Payment Interface</label><div class="col-sm-10"><select name="payment_mochipay_checkout_mode" class="form-control"><option value="HPP">HPP — Redirect to MochiPay</option><option value="ON_SITE"{{ payment_mochipay_checkout_mode == 'ON_SITE' ? ' selected' : '' }}>On-site — Payment dialog</option></select></div></div>
<div class="form-group"><label class="col-sm-2 control-label">Customer Payment Choices</label><div class="col-sm-10"><input type="hidden" name="payment_mochipay_payment_methods[]" value="" />{% for code, label in method_options %}<label style="display:block"><input type="checkbox" name="payment_mochipay_payment_methods[]" value="{{ code }}"{{ code in selected_methods ? ' checked' : '' }}> {{ label }}</label>{% endfor %}</div></div></form></div></div></div></div>{{ footer }}
